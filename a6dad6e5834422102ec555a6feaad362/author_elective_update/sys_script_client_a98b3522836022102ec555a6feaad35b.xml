        <description>Shows a pop up to enter firewall data</description>
        <field>u_rule_s_to_add_change_remove</field>
        <global>true</global>
        <isolate_script>false</isolate_script>
        <messages/>
        <name>mdfirewalladd</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return;
    }

    //Type appropriate comment here, and begin script below
    mfunction = g_form.getValue('u_mincident.u_rule_s_to_add_change_remove');
    g_form.setValue('u_mincident.u_rule_data.form-control', ' result');

    showCustomModal(myCallback);
}

function myCallback(result) {
    g_form.setValue('u_rule_data', result);
}

function showCustomModal(xCallback) {
    var modal = new GlideModal('custom_modal');
    modal.setTitle('Enter Your Data');

    // Define the HTML content with an input field
    modal.renderWithContent('<div style="padding: 20px;">' +
        '<input type="text" id="srcz" style="width:40%; margin-bottom:10px;" />' +
        '<input type="text" id="srcip" style="width:40%; margin-bottom:10px;" />' +
        '<input type="text" id="dstz" style="width:40%; margin-bottom:10px;" />' +
        '<input type="text" id="dstip" style="width:40%; margin-bottom:10px;" />' +
        '<button id="submitBtn">Submit</button>' +
        '</div>');

    // Add a click listener to the Submit button to send data back
    setTimeout(function() {
        var submitButton = document.getElementById('submitBtn');
        if (submitButton) {
            submitButton.onclick = function() {
                var srcz = document.getElementById('srcz').value;
                var srcip = document.getElementById('srcip').value;
                var dstz = document.getElementById('dstz').value;
                var dstip = document.getElementById('dstip').value;
                var userInput = srcz + ' | ' + srcip + ' | ' + dstz + ' | ' + dstip;
                xCallback(userInput);
                modal.close();
            };
        }
    }, 500);
}]]></script>

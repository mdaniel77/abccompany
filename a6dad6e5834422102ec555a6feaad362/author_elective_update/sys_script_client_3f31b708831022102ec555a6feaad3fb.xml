        <applies_extended>false</applies_extended>
        <condition/>
        <description>When Incident's impact changes, it's new value concatenated to the content of the short description.</description>
        <field>impact</field>
        <global>true</global>
        <isolate_script>false</isolate_script>
        <messages/>
        <name>mdimpactchanges</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return;
    }

    // If Impact changes it is concatenated to short_desc.
    var s_d = g_form.getValue('short_description');
    g_form.setValue('short_description', s_d.concat(newValue));
}]]></script>

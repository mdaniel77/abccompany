    <sys_script_include action="INSERT_OR_UPDATE">
        <access>package_private</access>
        <active>true</active>
        <api_name>global.mdssgetincidentstate</api_name>
        <caller_access/>
        <client_callable>true</client_callable>
        <description>Using Incident number as parameter, retrieves Incident and returns it's state to the caller.</description>
        <mobile_callable>false</mobile_callable>
        <name>mdssgetincidentstate</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var mdssgetincidentstate = Class.create();
mdssgetincidentstate.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

    getIncidentState: function() {
        var mstate = "*****";
        var mincidentnumber = this.getParameter('sysparm_num');
        var mincident = new GlideRecord('incident');
        mincident.addQuery('number', mincidentnumber);
        mincident.query();
        if (mincident.next()) {
            mstate = mincident.getValue('state');
        }
        return mstate;
    },

    type: 'mdssgetincidentstate'
});]]></script>
